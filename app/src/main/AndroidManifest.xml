<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 调整响铃模式 / 铃声音量。普通权限，安装即授予，无弹窗 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- iQOO / OriginOS 的“静音”有时实际是勿扰，退出勿扰需要此权限（用户在设置里授予） -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 开机 / 应用更新后重新登记低频兜底任务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        通讯录来电自动响铃的关键：系统默认只把“非通讯录号码”交给来电筛选服务，
        授予本权限后，通讯录联系人来电才会同样触发 CallGuardScreeningService。
        本应用仅持有该权限以改变系统筛选策略，绝不读取 / 遍历 / 上传任何联系人数据。
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_stat_guard"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            来电筛选服务：持有“来电筛选”角色后，系统会在每次来电、响铃之前
            把本服务拉起来调用一次（即使本应用平时没有任何进程在运行）。
            我们在那一刻恢复响铃并放行来电，因此运营商来电能自动恢复响铃，且平时零常驻进程。
        -->
        <service
            android:name=".CallGuardScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!--
            低频兜底任务：JobScheduler 周期触发，两次运行之间无常驻进程，
            不会“假死”，几乎不耗电。用于微信等 VoIP / 一般静音的最佳努力覆盖。
        -->
        <service
            android:name=".RingerJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            只接收系统的开机 / 应用更新广播（均为受保护的系统广播，外部应用无法伪造）。
            exported=false 即可：系统作为特权组件仍会投递这些广播，同时杜绝外部应用触达，
            安全边界更好。BOOT_COMPLETED 的接收依赖上面的 RECEIVE_BOOT_COMPLETED 权限。
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
